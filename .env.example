# =============================================================================
# Sri Lanka Edge-Native Weather Nowcasting & Flood-Prediction Configuration
# =============================================================================

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data

# Inference Engine (auto | hailo | cpu)
INFERENCE_BACKEND=auto
MODEL_HEF_PATH=./models/storm_yolov8s_seg.hef
CONFIDENCE_THRESHOLD=0.35

# Himawari-9 Satellite Ingestion (NASA GIBS WMS)
SATELLITE_POLL_INTERVAL_MIN=10
SATELLITE_RING_BUFFER_SIZE=12
SATELLITE_BACKFILL_FRAMES=6
SATELLITE_BBOX=75.0,3.0,86.0,12.0

# Open-Meteo Surface & Catchment Weather
OPEN_METEO_POLL_INTERVAL_MIN=30

# Sri Lanka Department of Irrigation ArcGIS Online REST Feature Services
# Leave blank to run in fallback/unavailable mode without breaking nowcasting.
IRRIGATION_ARCGIS_GAUGES_URL=
IRRIGATION_ARCGIS_RAINFALL_URL=
IRRIGATION_POLL_INTERVAL_MIN=15
IRRIGATION_FALLBACK_ENABLED=true
IRRIGATION_FALLBACK_URL=https://waterlevels.lk/api/levels

# Optional Local LLM Advisory Summarizer (Ollama on Pi 5 / LAN)
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:1b

# Optional Webhook Alerting (Generic JSON / Discord / Telegram)
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MIN=30

# Active-Learning Data Flywheel (Edge Capture & Pi 5 SD-Card Safety)
AL_ENABLED=true
AL_CONF_MIN=0.25
AL_CONF_MAX=0.55
AL_HEAVY_RAIN_MM_HR=20.0
AL_GAUGE_RISE_FT_HR=0.3
AL_CAPTURE_BOUNDARY_ARTIFACTS=true
AL_BOUNDARY_MARGIN_PX=3
AL_MAX_DAILY_CAPTURES=48
AL_MAX_STORAGE_MB=2048
